  "query": "SELECT e.cve_id, e.score, e.percentile, to_char(e.score_date, 'YYYY-MM-DD') AS \"date!\"\n           FROM epss_scores e\n           WHERE e.cve_id IN (SELECT unnest(cve_ids) FROM vulnerabilities WHERE canonical_id = $1)\n           ORDER BY e.score DESC, e.cve_id",
